# Supabase Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
# API key:     Supabase Dashboard -> Project Settings -> API -> Publishable key
#              (or the legacy "anon" key)
#
# The URL must match the key's project. Do not use the service_role/secret key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
